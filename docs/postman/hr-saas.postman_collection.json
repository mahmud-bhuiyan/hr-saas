{
  "info": {
    "_postman_id": "hr-saas-api-collection",
    "name": "HR SaaS API",
    "description": "All API requests for the HR SaaS platform. Import into Postman or use with Newman.\n\n**Setup:** Import `hr-saas.local.postman_environment.json` or set collection variables `baseUrl`, `accessToken`, and `pendingTenantId`.\n\n**Auth flow:** Register submits for approval (no token). Super admin approves, then company admin logs in. Login saves `accessToken` automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "pendingTenantId",
      "value": ""
    },
    {
      "key": "employeeId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Root",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/",
            "description": "Confirms the server is running."
          },
          "response": []
        },
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/health",
            "description": "Returns `{ status: \"ok\", service, timestamp }`."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Company",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  pm.collectionVariables.set('pendingTenantId', json.data.tenantId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"companyName\": \"Acme Ltd\",\n  \"email\": \"admin@acme.com\",\n  \"password\": \"TestPass123\",\n  \"firstName\": \"Jane\",\n  \"lastName\": \"Admin\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/register",
            "description": "Submits company for super admin approval. Returns pending status — no accessToken."
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', json.data.accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@acme.com\",\n  \"password\": \"TestPass123\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login",
            "description": "Returns accessToken after company is approved. Pending registrations get 403."
          },
          "response": []
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', json.data.accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/v1/auth/refresh",
            "description": "Requires refresh cookie from Login/Register. Postman cookie jar must be enabled."
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/v1/auth/logout",
            "description": "Clears the refresh token cookie."
          },
          "response": []
        },
        {
          "name": "Get Current User (me)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/auth/me",
            "description": "Returns full profile for any authenticated role (super_admin, company_admin, etc.)."
          },
          "response": []
        },
        {
          "name": "Update Profile (me)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Jane\",\n  \"lastName\": \"Admin\",\n  \"email\": \"admin@acme.com\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/me",
            "description": "Update own profile. Include currentPassword + newPassword to change password."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Companies (super_admin)",
      "item": [
        {
          "name": "List Pending Registrations",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/admin/registrations?status=pending",
            "description": "Requires super_admin Bearer token."
          },
          "response": []
        },
        {
          "name": "Create Company",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"companyName\": \"Acme Ltd\",\n  \"email\": \"admin@acme.com\",\n  \"password\": \"TestPass123\",\n  \"firstName\": \"Jane\",\n  \"lastName\": \"Admin\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/admin/registrations",
            "description": "Super admin creates an approved company and company admin. Admin can sign in immediately."
          },
          "response": []
        },
        {
          "name": "Approve Registration",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/v1/admin/registrations/{{pendingTenantId}}/approve",
            "description": "Approves pending company. Set pendingTenantId from Register response."
          },
          "response": []
        },
        {
          "name": "Reject Registration",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Does not meet onboarding criteria\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/admin/registrations/{{pendingTenantId}}/reject",
            "description": "Rejects pending company registration."
          },
          "response": []
        },
        {
          "name": "Update Company",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"companyName\": \"Acme Ltd\",\n  \"adminEmail\": \"admin@acme.com\",\n  \"adminFirstName\": \"Jane\",\n  \"adminLastName\": \"Admin\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/admin/registrations/{{tenantId}}",
            "description": "Updates an approved company. Set tenantId from list registrations response."
          },
          "response": []
        },
        {
          "name": "Deactivate Company",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/v1/admin/registrations/{{tenantId}}/deactivate",
            "description": "Deactivates an approved company and all tenant users."
          },
          "response": []
        },
        {
          "name": "Activate Company",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/v1/admin/registrations/{{tenantId}}/activate",
            "description": "Reactivates a deactivated approved company."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Create Admin (bootstrap super_admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"superadmin@hr.com\",\n  \"password\": \"User@123\",\n  \"role\": \"super_admin\",\n  \"firstName\": \"Super\",\n  \"lastName\": \"Admin\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/admins",
            "description": "Bootstrap: works without auth when DB has zero users. Otherwise requires super_admin Bearer token."
          },
          "response": []
        },
        {
          "name": "Create Admin (authenticated)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"hr@acme.com\",\n  \"password\": \"TestPass123\",\n  \"role\": \"hr_manager\",\n  \"firstName\": \"HR\",\n  \"lastName\": \"Manager\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/admins",
            "description": "Requires super_admin Bearer token when users already exist."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Employees",
      "item": [
        {
          "name": "List Employees",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/employees?search=&department=&status=",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "employees"],
              "query": [
                { "key": "search", "value": "" },
                { "key": "department", "value": "" },
                { "key": "status", "value": "" }
              ]
            },
            "description": "List employees for the authenticated tenant. Supports search, department, and status filters."
          },
          "response": []
        },
        {
          "name": "List Departments",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/employees/departments",
            "description": "Returns distinct department names for the tenant."
          },
          "response": []
        },
        {
          "name": "Create Employee",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  pm.collectionVariables.set('employeeId', json.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Alex\",\n  \"lastName\": \"Morgan\",\n  \"email\": \"alex.morgan@acme.com\",\n  \"jobTitle\": \"Software Engineer\",\n  \"department\": \"Engineering\",\n  \"startDate\": \"2024-03-01\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/employees",
            "description": "Requires company_admin or hr_manager (employee:create). Saves employeeId from response."
          },
          "response": []
        },
        {
          "name": "Get Employee",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
