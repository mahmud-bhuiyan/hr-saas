# Copy to .env.local and fill in values (never commit .env.local)
# PORT is optional — defaults to 5000 locally; Vercel sets it automatically
# Vercel: add these in Project Settings → Environment Variables (Production + Preview)

# MongoDB & Redis (server only)
MONGODB_URI=mongodb://localhost:27017/hr-saas
# If mongodb+srv:// fails with querySrv ECONNREFUSED on Windows, either:
# - use the standard (non-SRV) URI from Atlas Connect, or
# - set DNS_SERVERS=8.8.8.8,1.1.1.1 (auto-applied for mongodb+srv when unset)
REDIS_URL=redis://localhost:6379

# Frontend URL for CORS (your deployed client domain, e.g. https://your-app.vercel.app)
CLIENT_URL=http://localhost:5173

# JWT signing secret (auth tokens)
ADMIN_JWT_SECRET=change-me-admin-jwt-secret

# ImgBB API key (super admin logo/favicon upload — server only)
IMGBB_API_KEY=

# SendGrid (leave notification emails — logs to console when unset)
SENDGRID_API_KEY=
EMAIL_FROM=noreply@yourdomain.com
