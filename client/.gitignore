# =============================================================================
# Client — React + Vite (redundant with root .gitignore by design)
# =============================================================================

# Dependencies
node_modules/

# Build output
dist/
build/

# Vite dev cache
.vite/

# Environment / secrets (keep .env.example tracked)
.env
.env.local
.env.*.local

# Vercel local/deploy cache
.vercel

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test coverage
coverage/

# TypeScript / tooling cache
*.tsbuildinfo
.eslintcache

# OS
.DS_Store
Thumbs.db
