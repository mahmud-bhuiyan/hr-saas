# =============================================================================
# Root — repo-wide ignores (client/ and server/ also have their own .gitignore)
# =============================================================================

# Dependencies must live only inside client/ and server/
/node_modules/
node_modules/

# Forbidden / legacy layout (see AGENTS.md)
/shared/
apps/

# Build output
dist/
build/

# Environment / secrets (keep .env.example tracked)
.env
**/.env
.env.local
**/.env.local
.env.*.local
**/.env.*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test / tooling cache
coverage/
.vite/
*.tsbuildinfo
.eslintcache

# Deploy platforms
.vercel

# OS
.DS_Store
Thumbs.db
